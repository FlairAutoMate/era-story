{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/partner/jotun",
      "has": [{ "type": "host", "value": "www.era-app.no" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/partner/jotun",
      "has": [{ "type": "host", "value": "era-app.no" }],
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(assets|fonts|vendor|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
